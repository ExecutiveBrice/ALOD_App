{
  "name": "alod-presences",
  "version": "0.0.0",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "generate-api": "rm -rf src/app/api && openapi-generator-cli generate -i src/app/swagger-adhesion.json -g typescript-angular -o src/app/api -c openapi-generator.config.json --openapi-generator-ignore-list api.module.ts,index.ts,.gitignore,git_push.sh,README.md,.openapi-generator/ --global-property apiDocs=false,modelDocs=false,apiTests=false,modelTests=false"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@ionic/angular": "^9.0.2",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.1",
    "@angular/cli": "22.0.1",
    "@angular/compiler-cli": "22.0.1",
    "@angular/language-service": "22.0.1",
    "@capacitor/cli": "^8.5.1",
    "@ionic/angular-toolkit": "^13.0.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "angular-eslint": "22.0.0",
    "eslint": "^9.16.0",
    "jsdom": "^26.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.8"
  }
}
