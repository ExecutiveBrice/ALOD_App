  "paths": {
    "/auth/signin": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "authenticateUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/adherent/getById": {
      "get": {
        "tags": [
          "adherent-controller"
        ],
        "operationId": "getById",
        "parameters": [
          {
            "name": "adherentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Adherent"
                }
              }
            }
          }
        }
      }
    }
  },
